{
  "name": "no-handover",
  "private": true,
  "version": "0.1.0",
  "description": "No Handover (인수인계 없음) — private prototype: browser desktop outage-mystery game (Case 0 tutorial 위키가 안 열려요, Case 1 밤에만 실패하는 스크립트, Case 2 지웠는데 안 비워지는 디스크, Case 3 금요일 18:02의 작은 변경)",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs && node scripts/e2e-audio.mjs",
    "audio:render": "node scripts/audio-render.ts",
    "audio:ambience": "node scripts/ambience-render.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "1.64.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.6"
  }
}
