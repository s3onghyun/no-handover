{
  "name": "no-handover",
  "private": true,
  "version": "0.1.0",
  "description": "No Handover (인수인계 없음): a browser outage-mystery game. Take over a departed senior's PC and find the cause through chat, mail and a simulated terminal.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs && node scripts/e2e-audio.mjs",
    "audio:render": "node scripts/audio-render.ts",
    "audio:ambience": "node scripts/ambience-render.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "1.64.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.6"
  }
}
